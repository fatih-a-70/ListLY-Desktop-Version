<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="root" prefHeight="800.0" prefWidth="500.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.listly.StopwatchController">

    <children>

        <Label fx:id="headerText" layoutX="132.0" layoutY="101.0" prefHeight="64.0" prefWidth="255.0" style="-fx-font-size:25; -fx-font-weight:bold; -fx-text-fill:#010914;" text="Set Your Focus Time !">
         <font>
            <Font size="10.0" />
         </font></Label>

        <Label fx:id="timeText" layoutX="173.0" layoutY="191.0" prefHeight="63.0" prefWidth="200.0" style="-fx-font-size:40; -fx-font-weight:bold; -fx-text-fill:#010914;" text="00:00:00" />

        <Label fx:id="selectedModeLabel" layoutX="280.0" layoutY="40.0" prefHeight="21.0" prefWidth="160.0" style="-fx-font-size:15; -fx-font-weight:bold; -fx-text-fill:#010914;" text="Selected mode:" />

        <Label fx:id="modeLabel" layoutX="280.0" layoutY="58.0" prefHeight="36.0" prefWidth="172.0" style="-fx-font-size:15; -fx-font-weight:bold; -fx-text-fill:#010914;" text="(not selected)" />

        <Button fx:id="focusModeBtn" layoutX="40.0" layoutY="40.0" prefHeight="36.0" prefWidth="86.0" style="-fx-background-color:#001f3f; -fx-text-fill:white;" text="Focus Mode" />

        <Button fx:id="startBtn" layoutX="125.0" layoutY="291.0" prefHeight="50.0" prefWidth="69.0" style="-fx-background-color:#001f3f; -fx-text-fill:white;" text="Start" />

        <Button fx:id="stopBtn" layoutX="221.0" layoutY="291.0" prefHeight="50.0" prefWidth="77.0" style="-fx-background-color:#001f3f; -fx-text-fill:white;" text="Stop" />

        <Button fx:id="resetBtn" layoutX="324.0" layoutY="291.0" prefHeight="50.0" prefWidth="70.0" style="-fx-background-color:#001f3f; -fx-text-fill:white;" text="Reset" />

        <Button fx:id="tenMinBtn" layoutX="37.0" layoutY="375.0" prefHeight="50.0" prefWidth="86.0" style="-fx-background-color:#001f3f; -fx-text-fill:white;" text="10min" />

        <Button fx:id="thirtyMinBtn" layoutX="37.0" layoutY="455.0" prefHeight="50.0" prefWidth="86.0" style="-fx-background-color:#001f3f; -fx-text-fill:white;" text="30min" />

        <Button fx:id="oneHourBtn" layoutX="37.0" layoutY="536.0" prefHeight="50.0" prefWidth="86.0" style="-fx-background-color:#001f3f; -fx-text-fill:white;" text="1hr" />

        <Button fx:id="threeHourBtn" layoutX="37.0" layoutY="618.0" prefHeight="50.0" prefWidth="86.0" style="-fx-background-color:#001f3f; -fx-text-fill:white;" text="3hr" />

        <Button fx:id="historyBtn" layoutX="260.0" layoutY="711.0" prefHeight="56.0" prefWidth="143.0" style="-fx-background-color:#001f3f; -fx-text-fill:white;" text="Focus Sessions History" />

        <Button fx:id="customBtn" layoutX="106.0" layoutY="711.0" prefHeight="56.0" prefWidth="118.0" style="-fx-background-color:#001f3f; -fx-text-fill:white;" text="Set timer" />

    </children>
</AnchorPane>
