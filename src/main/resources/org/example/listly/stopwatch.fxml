<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="root"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.listly.StopwatchController"
            prefWidth="500.0" prefHeight="800.0">

    <children>

        <Label fx:id="headerText"
               layoutX="120.0" layoutY="80.0"
               prefWidth="260.0" prefHeight="73.0"
               text="Set Your Focus Time !"
               style="-fx-font-size:25; -fx-font-weight:bold; -fx-text-fill:#010914;"/>

        <Label fx:id="timeText"
               layoutX="150.0" layoutY="170.0"
               prefWidth="200.0" prefHeight="63.0"
               text="00:00:00"
               style="-fx-font-size:40; -fx-font-weight:bold; -fx-text-fill:#010914;"/>

        <Label fx:id="selectedModeLabel"
               layoutX="280.0" layoutY="40.0"
               prefWidth="160.0" prefHeight="21.0"
               text="Selected mode:"
               style="-fx-font-size:15; -fx-font-weight:bold; -fx-text-fill:#010914;"/>

        <Label fx:id="modeLabel"
               layoutX="280.0" layoutY="65.0"
               prefWidth="172.0" prefHeight="36.0"
               text="(not selected)"
               style="-fx-font-size:15; -fx-font-weight:bold; -fx-text-fill:#010914;"/>

        <Button fx:id="focusModeBtn"
                layoutX="40.0" layoutY="40.0"
                prefWidth="132.0" prefHeight="63.0"
                text="Focus Mode"/>

        <Button fx:id="startBtn"
                layoutX="80.0" layoutY="260.0"
                prefWidth="86.0" prefHeight="58.0"
                text="Start"/>

        <Button fx:id="stopBtn"
                layoutX="205.0" layoutY="260.0"
                prefWidth="93.0" prefHeight="57.0"
                text="Stop"/>

        <Button fx:id="resetBtn"
                layoutX="330.0" layoutY="260.0"
                prefWidth="102.0" prefHeight="56.0"
                text="Reset"/>

        <Button fx:id="tenMinBtn"
                layoutX="40.0" layoutY="340.0"
                prefWidth="100.0" prefHeight="50.0"
                text="10min"/>

        <Button fx:id="thirtyMinBtn"
                layoutX="40.0" layoutY="410.0"
                prefWidth="103.0" prefHeight="60.0"
                text="30min"/>

        <Button fx:id="oneHourBtn"
                layoutX="40.0" layoutY="490.0"
                prefWidth="106.0" prefHeight="49.0"
                text="1hr"/>

        <Button fx:id="threeHourBtn"
                layoutX="40.0" layoutY="560.0"
                prefWidth="103.0" prefHeight="56.0"
                text="3hr"/>

        <Button fx:id="historyBtn"
                layoutX="260.0" layoutY="700.0"
                prefWidth="160.0" prefHeight="64.0"
                text="Focus Sessions History"/>

        <Button fx:id="customBtn"
                layoutX="40.0" layoutY="700.0"
                prefWidth="147.0" prefHeight="61.0"
                text="Set timer"/>

    </children>
</AnchorPane>
