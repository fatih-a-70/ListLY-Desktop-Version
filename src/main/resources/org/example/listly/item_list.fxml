<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="root"
            prefWidth="500.0" prefHeight="800.0"
            style="-fx-background-color: transparent;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1">

    <children>
        <!-- top bar -->
        <HBox alignment="CENTER_LEFT" layoutX="16.0" layoutY="16.0"
              spacing="12.0" prefWidth="468.0">
            <children>
                <ImageView fx:id="ivBack"
                           fitWidth="32.0" fitHeight="32.0"
                           pickOnBounds="true" preserveRatio="true"/>

                <Label fx:id="tvTitle"
                       style="-fx-font-size:26; -fx-font-weight:bold; -fx-text-fill:#030320;"
                       text="My List"/>

                <Pane HBox.hgrow="ALWAYS"/>

                <ImageView fx:id="ivMenu"
                           fitWidth="28.0" fitHeight="28.0"
                           pickOnBounds="true" preserveRatio="true"/>
            </children>
        </HBox>

        <!-- list -->
        <ListView fx:id="itemsList"
                  layoutX="12.0" layoutY="80.0"
                  prefWidth="476.0" prefHeight="640.0"
                  style="-fx-background-color: transparent; -fx-control-inner-background: transparent;"/>
    </children>
</AnchorPane>
