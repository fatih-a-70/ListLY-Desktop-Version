<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="root"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.listly.RemindersController"
            prefWidth="500.0" prefHeight="800.0">

    <children>
        <Label fx:id="header"
               layoutX="100.0" layoutY="40.0"
               prefWidth="273.0" prefHeight="80.0"
               text="REMINDERS!"
               style="-fx-font-size:40; -fx-font-weight:bold; -fx-text-fill:#010914;"/>

        <!-- Task 1 -->
        <Label fx:id="task1"
               layoutX="40.0" layoutY="170.0"
               prefWidth="200.0" prefHeight="42.0"
               text="set task name"
               style="-fx-font-size:24; -fx-text-fill:#010914;"/>

        <Label fx:id="time1"
               layoutX="280.0" layoutY="180.0"
               prefWidth="115.0" prefHeight="35.0"
               text="set time"
               style="-fx-font-size:20; -fx-text-fill:#010914;"/>

        <ToggleButton fx:id="sw1"
                      layoutX="380.0" layoutY="177.0"
                      prefWidth="77.0" prefHeight="26.0"
                      text=""/>

        <!-- Task 2 -->
        <Label fx:id="task2"
               layoutX="40.0" layoutY="230.0"
               prefWidth="200.0" prefHeight="42.0"
               text="set task 2 name"
               style="-fx-font-size:24; -fx-text-fill:#010914;"/>

        <Label fx:id="time2"
               layoutX="280.0" layoutY="240.0"
               prefWidth="115.0" prefHeight="35.0"
               text="set time"
               style="-fx-font-size:20; -fx-text-fill:#010914;"/>

        <ToggleButton fx:id="sw2"
                      layoutX="380.0" layoutY="237.0"
                      prefWidth="77.0" prefHeight="26.0"
                      text=""/>

        <!-- Task 3 -->
        <Label fx:id="task3"
               layoutX="40.0" layoutY="300.0"
               prefWidth="200.0" prefHeight="42.0"
               text="set task 3 name"
               style="-fx-font-size:24; -fx-text-fill:#010914;"/>

        <Label fx:id="time3"
               layoutX="280.0" layoutY="310.0"
               prefWidth="115.0" prefHeight="35.0"
               text="set time"
               style="-fx-font-size:20; -fx-text-fill:#010914;"/>

        <ToggleButton fx:id="sw3"
                      layoutX="380.0" layoutY="307.0"
                      prefWidth="77.0" prefHeight="26.0"
                      text=""/>

        <!-- Task 4 -->
        <Label fx:id="task4"
               layoutX="40.0" layoutY="370.0"
               prefWidth="200.0" prefHeight="42.0"
               text="set task 4 name"
               style="-fx-font-size:24; -fx-text-fill:#010914;"/>

        <Label fx:id="time4"
               layoutX="280.0" layoutY="380.0"
               prefWidth="115.0" prefHeight="35.0"
               text="set time"
               style="-fx-font-size:20; -fx-text-fill:#010914;"/>

        <ToggleButton fx:id="sw4"
                      layoutX="380.0" layoutY="377.0"
                      prefWidth="77.0" prefHeight="26.0"
                      text=""/>

        <!-- Save button -->
        <Button fx:id="saveBtn"
                layoutX="177.5" layoutY="700.0"
                prefWidth="145.0" prefHeight="69.0"
                text="Save"/>
    </children>
</AnchorPane>
