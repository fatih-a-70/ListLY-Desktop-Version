<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane fx:id="root"
            prefHeight="56.0" prefWidth="460.0"
            style="-fx-background-color: transparent;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1">

    <children>
        <HBox layoutX="12.0" layoutY="10.0" spacing="12.0" prefWidth="436.0">
            <children>
                <CheckBox fx:id="cbNew"/>

                <TextField fx:id="etNewTitle"
                           promptText="New item"
                           style="-fx-background-color: transparent; -fx-text-fill:white; -fx-prompt-text-fill:#808080; -fx-border-color: transparent;"

                           prefWidth="380.0"/>
            </children>
        </HBox>
    </children>
</AnchorPane>
